# =============================================================================
# NETI BHARATHAM (నేటి భారతం) - APACHE PRODUCTION .HTACCESS FOR BIGROCK CPANEL
# Domain: https://netibhaaratham.com
# =============================================================================

Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Enforce HTTPS on Production Domain
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Block direct access to any dot-files (.env, .git, .htaccess)
    RewriteRule (^\.|/\.) - [F]

    # 3. Route Sitemap and Robots dynamically through API
    RewriteRule ^sitemap\.xml$ api/index.php?route=seo/sitemap [L,QSA]
    RewriteRule ^robots\.txt$ api/index.php?route=seo/robots [L,QSA]

    # 4. Route /api/* requests to PHP REST API Controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ api/index.php?route=$1 [L,QSA]

    # 5. Serve existing static assets (JS, CSS, Images, APK) directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. Route SEO-friendly frontend URLs to React SPA entry point (index.html)
    RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Browser Caching & Compression for Fast Mobile Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
